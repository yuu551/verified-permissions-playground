{
  "name": "verified-permissions-playground",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "npm run build:pages && node team-documents/preview-server.mjs",
    "build": "node team-documents/build.mjs",
    "build:pages": "node team-documents/pages.mjs",
    "test": "node --test team-documents/test/*.test.mjs",
    "test:ui": "playwright test",
    "synth": "npm run build && cdk synth --quiet",
    "deploy": "npm run build && cdk deploy --outputs-file cdk-team-outputs.json",
    "trial": "npm run build && node team-documents/trial.mjs",
    "seed": "node team-documents/seed.mjs",
    "access": "node team-documents/access.mjs",
    "verify:aws": "node team-documents/verify.mjs",
    "test:aws:ui": "TEAM_LIVE=1 playwright test",
    "drill:outage": "node team-documents/outage.mjs",
    "drill:restore": "node team-documents/restore.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1172.0",
    "@aws-sdk/client-dynamodb": "^3.1173.0",
    "@aws-sdk/client-sts": "^3.1173.0",
    "@aws-sdk/credential-providers": "^3.1173.0",
    "@aws-sdk/lib-dynamodb": "^3.1173.0",
    "@hono/node-server": "^1.19.19",
    "@verifiedpermissions/authorization-clients-js": "^0.2.0",
    "aws-cdk-lib": "^2.277.0",
    "aws-jwt-verify": "^5.2.1",
    "constructs": "^10.0.0",
    "hono": "^4.13.19",
    "hono-verified-permissions": "0.1.0"
  },
  "devDependencies": {
    "@cedar-policy/cedar-wasm": "^4.15.0",
    "@playwright/test": "^1.65.1",
    "aws-cdk": "^2.1100.0",
    "esbuild": "^0.28.0"
  }
}
